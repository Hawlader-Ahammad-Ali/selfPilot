<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_exam_input"
    android:padding="8dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/markerIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="App Icon" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/markerAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/exam_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/markerTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/exam_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
