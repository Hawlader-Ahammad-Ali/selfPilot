<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/exam_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Custom Lightning Icon -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_exam_input"
                android:backgroundTint="@color/exam_card"
                android:alpha="0.5"/>

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_media_play"
                app:tint="@color/purple_accent_light" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Focus Session"
            android:textColor="@color/exam_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="24dp"
            android:text="15:00"
            android:textColor="@color/purple_accent_light"
            android:textSize="96sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFocusWarning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Focus Mode Active. No early exit allowed."
            android:textColor="@color/warning_yellow"
            android:textSize="14sp"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/scrollPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:scrollbars="none">

            <RadioGroup
                android:id="@+id/rgPresets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <RadioButton
                    android:id="@+id/rb15Min"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_focus_preset"
                    android:button="@null"
                    android:checked="true"
                    android:drawableStart="@drawable/ic_focus_preset_radio"
                    android:drawablePadding="8dp"
                    android:paddingHorizontal="16dp"
                    android:text="15m"
                    android:textColor="@color/exam_text_secondary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb30Min"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_focus_preset"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_focus_preset_radio"
                    android:drawablePadding="8dp"
                    android:paddingHorizontal="16dp"
                    android:text="30m"
                    android:textColor="@color/exam_text_secondary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb60Min"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_focus_preset"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_focus_preset_radio"
                    android:drawablePadding="8dp"
                    android:paddingHorizontal="16dp"
                    android:text="1h"
                    android:textColor="@color/exam_text_secondary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb120Min"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_focus_preset"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_focus_preset_radio"
                    android:drawablePadding="8dp"
                    android:paddingHorizontal="16dp"
                    android:text="2h"
                    android:textColor="@color/exam_text_secondary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbCustomMin"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_focus_preset"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_focus_preset_radio"
                    android:drawablePadding="8dp"
                    android:paddingHorizontal="16dp"
                    android:text="Custom"
                    android:textColor="@color/exam_text_secondary"
                    android:textSize="14sp" />
            </RadioGroup>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/layoutCustomInput"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_exam_input"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="Custom Minutes:"
                android:textColor="@color/exam_text_secondary" />

            <EditText
                android:id="@+id/etCustomMinutes"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="45"
                android:inputType="number"
                android:maxLength="3"
                android:textColor="@color/exam_text_primary"
                android:textColorHint="@color/exam_text_secondary"
                android:textSize="16sp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_exam_primary_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_media_play"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Start Focus Session"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Session History Stats Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFocusStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/exam_card"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/exam_border"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today's Session Statistics"
                    android:textColor="@color/exam_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <!-- Sessions Completed -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@android:drawable/ic_menu_sort_by_size"
                                app:tint="@color/purple_accent_light"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Sessions Completed"
                                android:textColor="@color/exam_text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvFocusSessionsCompleted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="0"
                            android:textColor="@color/exam_text_primary"
                            android:textSize="28sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/exam_border"
                        android:layout_marginHorizontal="16dp"/>

                    <!-- Focus XP Earned -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@android:drawable/btn_star_big_on"
                                app:tint="@color/purple_accent_light"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Focus XP Earned"
                                android:textColor="@color/exam_text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvFocusXpEarned"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="0 XP"
                            android:textColor="@color/success_green"
                            android:textSize="28sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

    </LinearLayout>
</ScrollView>
