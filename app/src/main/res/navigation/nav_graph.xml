<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.selfpilot.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_apps"
        android:name="com.example.selfpilot.ui.apps.AppsFragment"
        android:label="Apps"
        tools:layout="@layout/fragment_apps" />

    <fragment
        android:id="@+id/navigation_focus"
        android:name="com.example.selfpilot.ui.focus.FocusFragment"
        android:label="Focus"
        tools:layout="@layout/fragment_focus" />

    <fragment
        android:id="@+id/navigation_score"
        android:name="com.example.selfpilot.ui.score.ScoreFragment"
        android:label="Score"
        tools:layout="@layout/fragment_score" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.example.selfpilot.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/navigation_analytics"
        android:name="com.example.selfpilot.ui.analytics.AnalyticsFragment"
        android:label="Analytics"
        tools:layout="@layout/fragment_analytics" />

</navigation>